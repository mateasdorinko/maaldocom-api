<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Transitive security pins">
    <!-- Microsoft.Data.SqlClient (via EF Core SqlServer) pulls vulnerable 9.0.11: GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="FastEndpoints" Version="8.3.0" />
    <PackageVersion Include="FastEndpoints.Security" Version="8.3.0" />
    <PackageVersion Include="FastEndpoints.Swagger" Version="8.3.0" />
    <PackageVersion Include="FastEndpoints.Testing" Version="8.3.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.2" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.19.0" />
    <PackageVersion Include="FluentResults" Version="4.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.5" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.9.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="FakeItEasy" Version="9.0.1" />
  </ItemGroup>
</Project>
